# Admin oturum token'larını imzalamak için kullanılır. ZORUNLU.
# Uzun ve rastgele bir değer üretin, örn: openssl rand -base64 48
JWT_SECRET=

# Panelin gizli adresi (baştaki / olmadan yazın), örn: yonetim-a1b2c3d4
# Tanımlıysa panel yalnızca /<bu değer> adresinden açılır ve /admin 404 döner.
# Boş bırakılırsa panel /admin adresinde çalışmaya devam eder.
# Bu değeri repoya koymayın; yalnızca sunucudaki .env dosyasında tutun.
ADMIN_PATH=

# Yalnızca yönetici tablosu boşken ilk hesabı oluşturmak için kullanılır.
# İlk giriş yapıldıktan sonra bu değişkenleri kaldırabilirsiniz.
ADMIN_DEFAULT_USER=
ADMIN_DEFAULT_PASSWORD=
