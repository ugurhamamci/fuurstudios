<!DOCTYPE html>
<html lang="tr" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FUUR STUDIO — Dijital Dönüşüm Ortağınız | Software & AI Solutions</title>
  <meta name="description" content="FUUR STUDIO: İstanbul merkezli yazılım, AI ve dijital dönüşüm şirketi. Kurumsal web siteleri, e-ticaret, yapay zeka entegrasyonları ve sosyal medya yönetimi." />
  
  <title><%= settings.site_meta_title || 'FUUR STUDIO - Digital Agency' %></title>
  <meta name="description" content="<%= settings.site_meta_description || 'Dijital dönüşüm ortağınız.' %>" />
  
  <link rel="stylesheet" href="css/variables.css" />
  <link rel="stylesheet" href="css/reset.css" />
  <link rel="stylesheet" href="css/typography.css" />
  <link rel="stylesheet" href="css/components.css" />
  <link rel="stylesheet" href="css/layout.css" />
  <link rel="stylesheet" href="css/sections.css" />
  <link rel="stylesheet" href="css/animations.css" />
</head>
<body>

  <!-- ═══════════════════════════════════════════
       NAVIGATION
       ═══════════════════════════════════════════ -->
  <nav class="nav" id="navbar">
    <div class="nav__inner">
      <!-- Logo -->
      <a href="#" class="nav__logo" aria-label="FUUR STUDIO">
        <img src="assets/logo-bw-2.png" data-logo-dark="assets/logo-bw-2.png" data-logo-light="assets/logo-bw-1.png" alt="FUUR STUDIO" class="nav__logo-img js-theme-logo" />
      </a>

      <!-- Desktop Links -->
      <div class="nav__links hide-mobile">
        <a href="#services" class="nav__link" data-i18n="nav.services">Hizmetler</a>
        <a href="#portfolio" class="nav__link" data-i18n="nav.portfolio">Projeler</a>
        <a href="#about" class="nav__link" data-i18n="nav.about">Hakkımızda</a>
        <a href="#team" class="nav__link" data-i18n="nav.team">Ekip</a>
        <a href="#testimonials" class="nav__link" data-i18n="nav.testimonials">Yorumlar</a>
        <a href="#blog" class="nav__link" data-i18n="nav.blog">Blog</a>
        <a href="#contact" class="nav__link" data-i18n="nav.contact">İletişim</a>
      </div>

      <!-- Actions -->
      <div class="nav__actions">
        <!-- Language Toggle -->
        <div class="lang-toggle hide-mobile">
          <button class="lang-toggle__option active" data-lang="tr">TR</button>
          <button class="lang-toggle__option" data-lang="en">EN</button>
        </div>

        <!-- Theme Toggle -->
        <button class="toggle-btn" id="theme-toggle" aria-label="Tema değiştir">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        </button>

        <!-- CTA -->
        <a href="#contact" class="btn btn--primary btn--sm hide-mobile" data-i18n="nav.cta">Projenizi Görüşelim</a>

        <!-- Hamburger -->
        <button class="nav__hamburger" aria-label="Menü">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div class="nav__mobile-menu">
      <a href="#services" class="nav__link" data-i18n="nav.services">Hizmetler</a>
      <a href="#portfolio" class="nav__link" data-i18n="nav.portfolio">Projeler</a>
      <a href="#about" class="nav__link" data-i18n="nav.about">Hakkımızda</a>
      <a href="#team" class="nav__link" data-i18n="nav.team">Ekip</a>
      <a href="#testimonials" class="nav__link" data-i18n="nav.testimonials">Yorumlar</a>
      <a href="#blog" class="nav__link" data-i18n="nav.blog">Blog</a>
      <a href="#contact" class="nav__link" data-i18n="nav.contact">İletişim</a>
      <div class="nav__mobile-actions">
        <div class="lang-toggle">
          <button class="lang-toggle__option active" data-lang="tr">TR</button>
          <button class="lang-toggle__option" data-lang="en">EN</button>
        </div>
        <a href="#contact" class="btn btn--primary btn--sm" data-i18n="nav.cta">Projenizi Görüşelim</a>
      </div>
    </div>
  </nav>


  <!-- ═══════════════════════════════════════════
       HERO SECTION
       ═══════════════════════════════════════════ -->
  <section class="hero section--lg" id="hero">
    <div class="container">
      <div class="hero__content">
        <span class="overline hero__overline" data-i18n="hero.overline">[ Dijital Dönüşüm Ortağınız ]</span>
        <h1 class="hero__title">
          <span data-i18n="hero.title.1">WEB SİTESİ DEĞİL,</span><br />
          <span class="text-gradient" data-i18n="hero.title.2">DİJİTAL PRESTİJ</span><br />
          <span data-i18n="hero.title.3">TASARLIYORUZ.</span>
        </h1>
        <p class="hero__description" data-i18n="hero.description">
          Sıradan şablonlar değil, markanıza özel, yüksek dönüşüm oranlı ve performansa odaklanmış modern dijital deneyimler geliştiriyoruz.
        </p>
        <div class="hero__actions">
          <a href="#services" class="btn btn--secondary btn--lg" data-i18n="hero.cta.primary">Hizmetlerimizi İnceleyin</a>
          <a href="#contact" class="btn btn--ghost btn--lg" data-i18n="hero.cta.secondary">Bizimle İletişime Geçin</a>
        </div>
      </div>

      <!-- Right Visual -->
      <div class="hero__visual">
        <div class="hero__visual-wrapper">
          <div class="hero__visual-ring"></div>
          <div class="hero__visual-ring-2"></div>
          
          <img src="assets/logo-full-white.png" data-logo-dark="assets/logo-full-white.png" data-logo-light="assets/logo-full.png" alt="FUUR STUDIO" class="hero__visual-logo js-theme-logo" />

          <!-- Badges -->
          <div class="hero__badge hero__badge--top-right">
            <svg class="hero__badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span data-i18n="hero.badge.performance">Top Performance</span>
          </div>

          <div class="hero__badge hero__badge--bottom-left">
            <svg class="hero__badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            <span data-i18n="hero.badge.ai">AI Integrated</span>
          </div>

          <div class="hero__badge hero__badge--bottom-right">
            <svg class="hero__badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            <span data-i18n="hero.badge.design">Award Winning</span>
          </div>
        </div>
      </div>

      <!-- Bottom Strips -->
      <div class="hero__bottom">
        <div class="hero__tech-strip">
          <span class="hero__tech-label" data-i18n="hero.tech.title">TECH STACK</span>
          <div class="hero__tech-logos">
            <div class="hero__tech-item">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm-2.051 17.576l-4.524-4.524 1.414-1.414 3.11 3.11 7.293-7.293 1.414 1.414-8.707 8.707z"/></svg>
              React & Next.js
            </div>
            <div class="hero__tech-item">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm-2.051 17.576l-4.524-4.524 1.414-1.414 3.11 3.11 7.293-7.293 1.414 1.414-8.707 8.707z"/></svg>
              Node.js
            </div>
            <div class="hero__tech-item">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm-2.051 17.576l-4.524-4.524 1.414-1.414 3.11 3.11 7.293-7.293 1.414 1.414-8.707 8.707z"/></svg>
              Python & AI Models
            </div>
            <div class="hero__tech-item">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm-2.051 17.576l-4.524-4.524 1.414-1.414 3.11 3.11 7.293-7.293 1.414 1.414-8.707 8.707z"/></svg>
              PostgreSQL
            </div>
            <div class="hero__tech-item">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm-2.051 17.576l-4.524-4.524 1.414-1.414 3.11 3.11 7.293-7.293 1.414 1.414-8.707 8.707z"/></svg>
              AWS & Cloud
            </div>
          </div>
        </div>

        <div class="hero__metrics">
          <div class="hero__metric">
            <span class="hero__metric-value">250<span class="accent">+</span></span>
            <span class="hero__metric-label" data-i18n="hero.metric.1">Projects</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">98<span class="accent">%</span></span>
            <span class="hero__metric-label" data-i18n="hero.metric.2">Success Rate</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">24<span class="accent">/</span>7</span>
            <span class="hero__metric-label" data-i18n="hero.metric.3">Support</span>
          </div>
        </div>
      </div>
    </div>
    <!-- Background decorations -->
    <div class="hero__bg">
      <div class="orb orb--red hero__orb-1"></div>
      <div class="orb orb--white hero__orb-2"></div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       SERVICES SECTION
       ═══════════════════════════════════════════ -->
  <section class="services section" id="services">
    <div class="container">
      <div class="section-header section-header--split reveal">
        <div>
          <span class="overline" data-i18n="services.overline">Neler Yapıyoruz?</span>
          <h2 class="heading-lg" data-i18n="services.title">HİZMETLERİMİZ</h2>
        </div>
        <p class="body-sm" style="max-width: 380px;" data-i18n="services.subtitle">
          İşletmenizi dijital dünyada konumlandırırken ihtiyacınız olan tüm teknik ve kreatif altyapıyı sağlıyoruz.
        </p>
      </div>

      <div class="services__grid stagger-children">
        <!-- Service 1 -->
        <div class="card card--accent-hover reveal">
          <span class="card__number">01 //</span>
          <h3 class="card__title" data-i18n="services.1.title">Kurumsal Web Siteleri</h3>
          <p class="card__description" data-i18n="services.1.desc">
            Hızlı, modern, SEO ve mobil uyumlu, markanızın kalitesini ve niş yapısını yansıtan prestijli web siteleri tasarlıyoruz.
          </p>
          <span class="card__tags" data-i18n="services.1.tags">Next.js • Custom Design • SEO</span>
        </div>

        <!-- Service 2 -->
        <div class="card card--accent-hover reveal">
          <span class="card__number">02 //</span>
          <h3 class="card__title" data-i18n="services.2.title">E-Ticaret Çözümleri</h3>
          <p class="card__description" data-i18n="services.2.desc">
            Satış odaklı, güvenli ödeme altyapısına sahip, kullanıcı deneyimi en üst düzeyde tutulmuş online mağazalar geliştiriyoruz.
          </p>
          <span class="card__tags" data-i18n="services.2.tags">Secure • Scalable • Conversive</span>
        </div>

        <!-- Service 3 -->
        <div class="card card--accent-hover reveal">
          <span class="card__number">03 //</span>
          <h3 class="card__title" data-i18n="services.3.title">Yapay Zeka & Otomasyon</h3>
          <p class="card__description" data-i18n="services.3.desc">
            İş süreçlerinizi hızlandıran özel yazılımlar ve akıllı yapay zeka entegrasyonları ile operasyonel verimlilik sağlıyoruz.
          </p>
          <span class="card__tags" data-i18n="services.3.tags">AI Integrations • Workflow Automation</span>
        </div>

        <!-- Service 4 -->
        <div class="card card--accent-hover reveal">
          <span class="card__number">04 //</span>
          <h3 class="card__title" data-i18n="services.4.title">Sosyal Medya Yönetimi</h3>
          <p class="card__description" data-i18n="services.4.desc">
            Strateji, kreatif içerik üretimi ve Meta Ads reklam yönetimi ile markanızı doğru kitleye ulaştırıyoruz.
          </p>
          <span class="card__tags" data-i18n="services.4.tags">Strategy • Content • Ads Management</span>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       PORTFOLIO SECTION
       ═══════════════════════════════════════════ -->
  <section class="portfolio section" id="portfolio">
    <div class="container">
      <div class="section-header section-header--split reveal">
        <div>
          <span class="overline" data-i18n="portfolio.overline">Çalışmalarımız</span>
          <h2 class="heading-lg" data-i18n="portfolio.title">PROJELER</h2>
        </div>
        <p class="body-sm" style="max-width: 380px;" data-i18n="portfolio.subtitle">
          Her projede markanın DNA'sını dijitale taşıyan, dönüşüm odaklı çözümler üretiyoruz.
        </p>
      </div>

      <!-- Filters -->
      <div class="portfolio__filters reveal">
        <button class="portfolio__filter active" data-filter="all" data-i18n="portfolio.filter.all">Tümü</button>
        <button class="portfolio__filter" data-filter="web" data-i18n="portfolio.filter.web">Web</button>
        <button class="portfolio__filter" data-filter="ecommerce" data-i18n="portfolio.filter.ecommerce">E-Ticaret</button>
        <button class="portfolio__filter" data-filter="mobile" data-i18n="portfolio.filter.mobile">Mobil</button>
        <button class="portfolio__filter" data-filter="ai" data-i18n="portfolio.filter.ai">AI</button>
      </div>

      <!-- Grid -->
      <div class="portfolio__grid stagger-children" id="portfolio-grid">
        <% projects.forEach(function(p) { %>
          <% let catText = p.category === 'web' ? 'Web Sitesi' : (p.category === 'ecommerce' ? 'E-Ticaret' : (p.category === 'mobile' ? 'Mobil Uygulama' : 'AI Çözümleri')); %>
          <div class="portfolio__item reveal" data-category="<%= p.category %>">
            <img src="<%= p.image %>" alt="<%= p.title %>" class="portfolio__image" loading="lazy" />
            <div class="portfolio__overlay">
              <span class="portfolio__category"><%= catText %></span>
              <h3 class="portfolio__title"><%= p.title %></h3>
              <p class="portfolio__desc"><%= p.description %></p>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       ABOUT SECTION
       ═══════════════════════════════════════════ -->
  <section class="about section" id="about">
    <div class="container">
      <div class="about__grid">
        <!-- Text Side -->
        <div class="about__text reveal-left">
          <span class="overline" data-i18n="about.overline">Biz Kimiz?</span>
          <h2 class="heading-lg" data-i18n="about.title">HAKKIMIZDA</h2>
          <p data-i18n="about.p1">
            FUUR STUDIO olarak, İstanbul merkezli bir yazılım ve dijital dönüşüm şirketiyiz. Amacımız sadece web sitesi yapmak değil; markanızın dijital dünyada hak ettiği prestiji inşa etmektir.
          </p>
          <p data-i18n="about.p2">
            Her projemizde performans, estetik ve dönüşüm üçgeninde mükemmelliği hedefliyoruz. Şablon çözümler yerine, markanıza özel tasarlanmış dijital deneyimler sunuyoruz.
          </p>
          <p data-i18n="about.p3">
            Yapay zeka entegrasyonları, özel yazılım geliştirme ve sosyal medya stratejileri ile işletmelerin dijital olgunluğunu bir üst seviyeye taşıyoruz.
          </p>
        </div>

        <!-- Metrics Side -->
        <div class="metrics reveal-right">
          <div class="metric">
            <div class="metric__value" data-count="250" data-suffix="+">0</div>
            <div class="metric__label" data-i18n="metric.projects">Tamamlanan Proje</div>
          </div>
          <div class="metric">
            <div class="metric__value metric__value--white" data-count="98">0</div>
            <div class="metric__label" data-i18n="metric.speed">Site Hız Skoru</div>
          </div>
          <div class="metric">
            <div class="metric__value metric__value--white" data-count="98" data-prefix="%" >0</div>
            <div class="metric__label" data-i18n="metric.satisfaction">Müşteri Memnuniyeti</div>
          </div>
          <div class="metric">
            <div class="metric__value metric__value--white" data-count="5" data-suffix="+">0</div>
            <div class="metric__label" data-i18n="metric.experience">Yıllık Tecrübe</div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       TEAM SECTION
       ═══════════════════════════════════════════ -->
  <section class="team section" id="team">
    <div class="container">
      <div class="section-header section-header--center reveal">
        <span class="overline" data-i18n="team.overline">Arkamızdaki Güç</span>
        <h2 class="heading-lg" data-i18n="team.title">EKİBİMİZ</h2>
        <p class="body-base" style="max-width: 500px;" data-i18n="team.subtitle">
          Her biri alanında uzman, tutkulu profesyonellerden oluşan bir ekibiz.
        </p>
      </div>

      <div class="team__grid stagger-children">
        <!-- Member 1 -->
        <div class="team__member reveal">
          <div class="team__avatar" style="background: linear-gradient(135deg, var(--brand-red) 0%, #1a1a1a 100%); display:flex; align-items:center; justify-content:center; color:#fff; font-weight:700; font-size:1.5rem; font-family:var(--font-heading); width:80px; height:80px; border-radius:50%; margin:0 auto var(--space-5);">UY</div>
          <h3 class="team__name" data-i18n="team.1.name">Uğur Yılmaz</h3>
          <p class="team__role" data-i18n="team.1.role">Kurucu & Full-Stack Developer</p>
          <p class="team__bio" data-i18n="team.1.bio">Dijital çözümler ve AI entegrasyonları konusunda uzman.</p>
          <div class="team__socials">
            <a href="https://www.instagram.com/fuurstudio/" target="_blank" class="social-link" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
            <a href="https://wa.me/905448508960" target="_blank" class="social-link" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </a>
          </div>
        </div>

        <!-- Member 2 -->
        <div class="team__member reveal">
          <div class="team__avatar" style="background: linear-gradient(135deg, #667eea 0%, #1a1a1a 100%); display:flex; align-items:center; justify-content:center; color:#fff; font-weight:700; font-size:1.5rem; font-family:var(--font-heading); width:80px; height:80px; border-radius:50%; margin:0 auto var(--space-5);">EK</div>
          <h3 class="team__name" data-i18n="team.2.name">Elif Karaca</h3>
          <p class="team__role" data-i18n="team.2.role">UI/UX Tasarımcı</p>
          <p class="team__bio" data-i18n="team.2.bio">Kullanıcı odaklı, estetik ve işlevsel arayüzler tasarlıyor.</p>
